Panels:
- Class: rviz/Displays
  Name: Displays
  Property Tree Widget:
    Expanded: []
    Splitter Ratio: 0.5
  Tree Height: 500
- Class: rviz/Selection
  Name: Selection
- Class: rviz/Views
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/Grid
    Enabled: true
    Name: Grid
    Plane: XY
    Plane Cell Count: 20
    Cell Size: 1
    Reference Frame: viz_world
    Value: true
  - Class: rviz/PointCloud2
    Enabled: false
    Name: UGV LIO-SAM Map
    Topic: /lio_sam/mapping/map_global
    Queue Size: 5
    Size (Pixels): 2
    Size (m): 0.05
    Color Transformer: AxisColor
    Axis: Z
    Value: false
  - Class: rviz/Path
    Enabled: true
    Name: UGV LIO-SAM Path
    Topic: /lio_sam/mapping/path
    Buffer Length: 1
    Value: true
  - Class: rviz/PointCloud2
    Enabled: false
    Name: UAV LIO-SAM Map
    Topic: /uav/lio_sam/mapping/map_global
    Queue Size: 5
    Size (Pixels): 2
    Size (m): 0.05
    Color Transformer: AxisColor
    Axis: Z
    Value: false
  - Class: rviz/Path
    Enabled: true
    Name: UAV LIO-SAM Path
    Topic: /uav/lio_sam/mapping/path
    Buffer Length: 1
    Value: true
  - Class: rviz/PointCloud2
    Enabled: true
    Name: UGV Registered Scan
    Topic: /lio_sam/mapping/cloud_registered_raw
    Queue Size: 2
    Size (Pixels): 1
    Style: Points
    Decay Time: 0
    Alpha: 0.5
    Color Transformer: FlatColor
    Color: 160; 200; 160
    Value: true
  - Class: rviz/PointCloud2
    Enabled: true
    Name: UAV Registered Scan
    Topic: /uav/lio_sam/mapping/cloud_registered_raw
    Queue Size: 2
    Size (Pixels): 1
    Style: Points
    Decay Time: 0
    Alpha: 0.5
    Color Transformer: FlatColor
    Color: 150; 170; 210
    Value: true
  - Class: rviz/PointCloud2
    Enabled: true
    Name: UGV EHPR Submap
    Topic: /stage2/ugv/submap_cloud
    Queue Size: 2
    Size (Pixels): 3
    Size (m): 0.05
    Style: Points
    Decay Time: 0
    Color Transformer: AxisColor
    Axis: Z
    Value: true
  - Class: rviz/PointCloud2
    Enabled: true
    Name: UAV EHPR Submap
    Topic: /stage2/uav/submap_cloud
    Queue Size: 2
    Size (Pixels): 3
    Size (m): 0.05
    Style: Points
    Decay Time: 0
    Color Transformer: AxisColor
    Axis: Z
    Value: true
  Enabled: true
  Global Options:
    Fixed Frame: viz_world
    Background Color: 35; 38; 42
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  - Class: rviz/SetInitialPose
  - Class: rviz/SetGoal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 40
      Focal Point:
        X: -3
        Y: -3
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.7
Window Geometry:
  Height: 900
  Width: 1500
