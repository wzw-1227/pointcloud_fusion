<launch>
  <!-- Manual rendezvous in either motion direction; ideal frontend, not LIO acceptance. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="record" default="true"/>
  <arg name="matching_profile" default="partial"/>
  <arg name="warm_start_inputs" default=""/>
  <arg name="output_root" default="$(find start_up)/../../results/stage3_rendezvous"/>
  <include file="$(find start_up)/launch/stage3_gazebo_algorithm.launch">
    <arg name="world" value="$(find start_up)/worlds/stage3_rendezvous.world"/>
    <!-- <arg name="ugv_x" value="-5.6"/> -->
    <!-- <arg name="ugv_y" value="-3.5"/> -->
    <arg name="ugv_x" value="4.0"/> 
    <arg name="ugv_y" value="7.0"/>
    <arg name="uav_x" value="-7.0"/>
    <arg name="uav_y" value="5.0"/>
    <arg name="uav_z" value="0.3"/>
    <arg name="max_range" value="12.0"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="rviz_config" value="$(find start_up)/rviz/stage3_rendezvous.rviz"/>
    <arg name="record" value="$(arg record)"/>
    <arg name="matching_profile" value="$(arg matching_profile)"/>
    <arg name="warm_start_inputs" value="$(arg warm_start_inputs)"/>
    <arg name="manual_control" value="true"/>
    <arg name="output_root" value="$(arg output_root)"/>
  </include>
</launch>
