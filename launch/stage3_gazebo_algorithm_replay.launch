<launch>
  <!-- Replay previously saved real scans assembled by the ideal frontend. -->
  <arg name="input_directory"/>
  <arg name="rviz" default="true"/>
  <arg name="config" default="$(find start_up)/config/stage3_gazebo_algorithm_matching.yaml"/>
  <arg name="output_root" default="$(find start_up)/../../results/stage3_gazebo_algorithm/replay"/>
  <param name="use_sim_time" value="false"/>
  <include file="$(find ehpr_bridge)/launch/stage3_matching.launch">
    <arg name="mode" value="replay"/>
    <arg name="input_directory" value="$(arg input_directory)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="output_root" value="$(arg output_root)"/>
    <arg name="keep_alive" value="true"/>
  </include>
  <node pkg="tf2_ros" type="static_transform_publisher" name="algorithm_replay_frame"
        args="0 0 0 0 0 0 algorithm_replay_world algorithm_ugv_odom"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="algorithm_replay_rviz"
        args="-d $(find start_up)/rviz/stage3_gazebo_algorithm_replay.rviz"/>
</launch>
