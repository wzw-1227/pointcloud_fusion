<launch>
  <arg name="namespace" default="/"/>
  <arg name="config_file"/>
  <arg name="real" default="false"/>
  <arg name="robot"/>
  <arg name="loop_closure" default="config"/>
  <group ns="$(arg namespace)">
    <rosparam file="$(arg config_file)" command="load"/>
    <param if="$(eval arg('loop_closure') != 'config')" name="lio_sam/loopClosureEnableFlag" value="$(arg loop_closure)" type="bool"/>
    <!-- Fail visibly on crashes during validation; do not hide them by respawning. -->
    <node pkg="lio_sam" type="lio_sam_imuPreintegration" name="lio_sam_imuPreintegration" required="true" output="screen"
      launch-prefix="$(eval 'rosrun start_up stage1_real_exec.py --config &quot;' + arg('config_file') + '&quot;' if arg('real') else '')"/>
    <node pkg="lio_sam" type="lio_sam_imageProjection" name="lio_sam_imageProjection" required="true" output="screen"
      launch-prefix="$(eval 'rosrun start_up stage1_real_exec.py --config &quot;' + arg('config_file') + '&quot;' if arg('real') else '')"/>
    <node pkg="lio_sam" type="lio_sam_featureExtraction" name="lio_sam_featureExtraction" required="true" output="screen"
      launch-prefix="$(eval 'rosrun start_up stage1_real_exec.py --config &quot;' + arg('config_file') + '&quot;' if arg('real') else '')"/>
    <node pkg="lio_sam" type="lio_sam_mapOptmization" name="lio_sam_mapOptmization" required="true" output="screen"
      launch-prefix="$(eval 'rosrun start_up stage1_real_exec.py --config &quot;' + arg('config_file') + '&quot;' if arg('real') else '')"/>
  </group>
</launch>
