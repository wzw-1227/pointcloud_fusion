+std::vector<CoarseCandidate> DescriptorDB::queryEnhanced(
+    const std::shared_ptr<const DescriptorManager>& query,size_t limit) {
+  std::vector<CoarseCandidate> output;std::vector<int> ids;
+  for(const auto& item:descriptor_matches_)ids.push_back(item.first);std::sort(ids.begin(),ids.end());
+  for(int id:ids){const auto reference=all_bevs_.at(id);std::vector<map_closures::PointPair> pairs;
+    for(const auto& match:descriptor_matches_.at(id))for(const auto& ref:match.object_references){
+      const auto r=ref.second,q=match.object_query.second;
+      map_closures::PointPair pair(Eigen::Vector2d((r.x()-cfg_.n_row_/2)*cfg_.reso_row_,(r.y()-cfg_.n_col_/2)*cfg_.reso_col_),
+        Eigen::Vector2d((q.x()-cfg_.n_row_/2)*cfg_.reso_row_,(q.y()-cfg_.n_col_/2)*cfg_.reso_col_),ref.first,match.object_query.first);
+      pair.dist=match.distance;pairs.push_back(pair);
+    }
+    std::sort(pairs.begin(),pairs.end(),[](const auto& a,const auto& b){
+      return std::make_tuple(a.dist,a.qur_idx,a.ref_idx)<std::make_tuple(b.dist,b.qur_idx,b.ref_idx);});
+    std::set<std::pair<int,int>> unique;
+    pairs.erase(std::remove_if(pairs.begin(),pairs.end(),[&](const auto& pair){return !unique.emplace(pair.ref_idx,pair.qur_idx).second;}),pairs.end());
+    const auto raw=pairs.size();if(pairs.size()>4096)pairs.resize(4096);
+    const auto hypotheses=map_closures::RansacHypotheses2D(pairs,
+      uint32_t(0x9e3779b9u*uint32_t(id+1)^uint32_t(query->getIntID()+1)),1000,cfg_.planar_inlier_distance_,1.);
+    for(const auto& h:hypotheses){if(h.inliers.size()<5)continue;
+      CoarseCandidate c;c.reference_id=reference->attach_idx_;c.inliers=h.inliers.size();c.planar_rmse=h.rmse;c.raw_correspondences=raw;
+      c.pose.block<2,2>(0,0)=h.pose.linear();c.pose.block<2,1>(0,3)=h.pose.translation();
+      int rn,qn;float rr,qr;reference->getBinInfo(rn,rr);query->getBinInfo(qn,qr);
+      const auto rh=reference->getHightMinMax(),qh=query->getHightMinMax();
+      std::vector<int> add(rn+qn,0),sub(rn+qn,0);
+      for(int index:h.inliers){++c.height_pairs;const auto& pair=pairs[index];
+        const auto rb=reference->getKeyHeightBin(pair.ref_idx),qb=query->getKeyHeightBin(pair.qur_idx);
+        if(!rb.any()||!qb.any()){++c.empty_height_pairs;continue;}
+        int rbegin=rb.find_first(),qbegin=qb.find_first();
+        int rend=std::min(rn-1,std::max(int(std::floor(-rh.second/rr)),find_last(rb)));
+        int qend=std::min(qn-1,std::max(int(std::floor(-qh.second/qr)),find_last(qb)));
+        for(int offset=0;offset<rn+qn;++offset){int lo=std::max(qbegin,offset-(rn-rbegin)+1),hi=std::min(qend,offset-(rn-rend)+1);
+          for(int k=lo;k<=hi;++k){if(qb[k]==rb[k-offset+rn-1])++add[offset];else --sub[offset];}}
+      }
+      int best=-1;for(int i=0;i<rn+qn;++i)
+        if(best<0||add[i]+sub[i]>add[best]+sub[best]||(add[i]+sub[i]==add[best]+sub[best]&&add[i]>add[best]))best=i;
+      if(best>=0&&add[best]>0){c.pose(2,3)=qh.second+(best+.5)*qr-rh.first;c.height_valid=std::isfinite(c.pose(2,3));}
+      output.push_back(c);
+    }
+  }
+  std::stable_sort(output.begin(),output.end(),[](const auto& a,const auto& b){
+    if(a.inliers!=b.inliers)return a.inliers>b.inliers;
+    if(a.planar_rmse!=b.planar_rmse)return a.planar_rmse<b.planar_rmse;
+    return a.reference_id<b.reference_id;});
+  if(output.size()>limit)output.resize(limit);return output;
+}
