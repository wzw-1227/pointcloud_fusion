+      if(error<threshold*threshold)eligible.emplace_back(error,int(i));}
+    std::sort(eligible.begin(),eligible.end());std::array<bool,512> used_ref{},used_query{};
+    RansacHypothesis h;h.pose=pose;double sum=0;
+    for(const auto& e:eligible){const auto& pair=pairs[e.second];
+      if(pair.ref_idx<0||pair.qur_idx<0||pair.ref_idx>=512||pair.qur_idx>=512)continue;
+      if(used_ref[pair.ref_idx]||used_query[pair.qur_idx])continue;
+      used_ref[pair.ref_idx]=used_query[pair.qur_idx]=true;h.inliers.push_back(e.second);sum+=e.first;}
+    h.rmse=h.inliers.empty()?1e9:std::sqrt(sum/h.inliers.size());return h;
+  };
+  auto better=[](const RansacHypothesis& a,const RansacHypothesis& b){
+    return a.inliers.size()!=b.inliers.size()?a.inliers.size()>b.inliers.size():a.rmse<b.rmse;};
+  std::mt19937 rng(seed);std::uniform_int_distribution<size_t> pick(0,pairs.size()-1);
