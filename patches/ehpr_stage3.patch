+       (a.ref-b.ref).norm()<minimum_baseline||(a.query-b.query).norm()<minimum_baseline)continue;
+    auto h=score(KabschUmeyamaAlignment2D({a,b}));if(h.inliers.size()<3)continue;
+    for(int k=0;k<2;++k){std::vector<PointPair> fit;for(int index:h.inliers)fit.push_back(pairs[index]);
